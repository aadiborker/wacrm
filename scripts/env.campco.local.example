# Copy to Desktop\WACRM-campco\.env.local (never commit).
# Different Supabase + Meta + ENCRYPTION_KEY from Pashupathi.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-CAMPCO-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-campco-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-campco-service-role-key

ENCRYPTION_KEY=generate-with-node-randomBytes-32-hex

META_APP_SECRET=from-replyflow-campco-meta-app
META_APP_ID=from-replyflow-campco-meta-app

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_LOCALE=en

# Uncomment for template UI without calling Meta:
# WHATSAPP_TEMPLATES_DRY_RUN=true
