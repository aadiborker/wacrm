# Campco ReplyFlow — separate vhost from Pashupathi (scripts/nginx-wacrm.conf.example).
# App listens on 127.0.0.1:3001 (PM2 name wacrm-campco).
#
#   sudo cp scripts/nginx-campco.conf.example /etc/nginx/sites-available/wacrm-campco
#   sudo ln -sf /etc/nginx/sites-available/wacrm-campco /etc/nginx/sites-enabled/wacrm-campco
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d campco.thewebpeople.co

server {
    listen 80;
    server_name campco.thewebpeople.co;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        send_timeout 180s;
    }
}
